{
  "manifest_version": 3,
  "name": "Course Files for Moodle",
  "version": "0.1.2",
  "description": "Download native File and Folder resources from your selected Moodle courses into organized local folders.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "webRequest", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open Course Files", "default_icon": {"16":"icons/16.png","32":"icons/32.png"}},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}
}
